{
  "name": "@repo/folder-reveal",
  "description": "A FolderReveal component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "layout",
    "tags": [
      "folder",
      "reveal",
      "fan",
      "stack",
      "hover",
      "click",
      "animated"
    ],
    "complexity": "moderate",
    "animationType": "spring",
    "useCases": [
      "Reveal a set of files or cards from an animated folder",
      "Playful navigation entry point that fans out shortcuts",
      "Dashboard widget that discloses grouped content on demand"
    ],
    "compositionHints": [
      "Use with small preview cards as folder items",
      "Pair with tooltips on individual cards for extra context"
    ],
    "hasReducedMotion": true
  }
}
