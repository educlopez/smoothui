{
  "name": "@repo/swap-panel",
  "description": "A SwapPanel component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "form",
    "tags": [
      "swap",
      "exchange",
      "currency",
      "token",
      "form",
      "animated",
      "finance-ui"
    ],
    "complexity": "complex",
    "animationType": "spring",
    "useCases": [
      "Token or currency swap form with live quote updates",
      "Exchange widget with flip-direction and animated output figure",
