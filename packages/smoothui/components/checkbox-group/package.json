{
  "name": "@repo/checkbox-group",
  "description": "Checkbox Group for SmoothUI with parent/indeterminate support, Base UI twin and Radix-parity twin.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "checkbox",
      "group",
      "indeterminate",
      "form"
    ],
    "complexity": "simple",
    "animationType": "spring",
    "useCases": [
      "Multi-select option lists",
      "Parent checkbox with select-all"
    ],
    "compositionHints": [
      "Pass allValues when using a parent CheckboxGroupItem",
      "Pair with Field for labelled form sections"
    ],
    "hasReducedMotion": true
  }
}
