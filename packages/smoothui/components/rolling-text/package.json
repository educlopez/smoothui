{
  "name": "@repo/rolling-text",
  "description": "A RollingText text animation component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "text",
    "tags": [
      "text",
      "odometer",
      "split-flap",
      "roll",
      "counter",
      "animated"
    ],
    "complexity": "moderate",
    "animationType": "tween",
    "useCases": [
      "Odometer-style counters and stat displays",
      "Split-flap airport-board style headings",
      "Playful hover-triggered label reveals"
    ],
    "compositionHints": [
      "Use monospace or tabular-nums fonts for the steadiest column widths",
      "Pair `trigger=\"manual\"` with a `playing` flag for replay controls"
    ],
    "hasReducedMotion": true
  }
}
