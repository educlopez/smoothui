{
  "name": "@repo/empty",
  "description": "Empty state layout for SmoothUI — title, description, and optional action.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "empty",
      "blank",
      "placeholder",
      "display"
    ],
    "complexity": "simple",
    "useCases": [
      "No results lists",
      "First-run empty panels"
    ],
    "compositionHints": [
      "Pass an action slot for primary CTA",
      "Keep title short; description optional"
    ]
  }
}
