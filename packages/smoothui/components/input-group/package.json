{
  "name": "@repo/input-group",
  "description": "Input Group with leading/trailing addons for SmoothUI form controls.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "input",
      "group",
      "addon",
      "form"
    ],
    "complexity": "simple",
    "useCases": [
      "Currency and unit prefixes",
      "Search inputs with trailing actions"
    ],
    "compositionHints": [
      "Place Input as the only text control child",
      "Use InputGroupText for static affixes"
    ]
  }
}
