{
  "name": "@repo/breakpoint-indicator",
  "description": "A BreakpointIndicator component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "utility",
    "tags": [
      "dev-tool",
      "breakpoint",
      "responsive",
      "badge",
      "debug",
      "viewport"
    ],
    "complexity": "simple",
    "animationType": "spring",
    "useCases": [
      "Debug badge showing the active Tailwind breakpoint during development",
      "Viewport size readout while testing responsive layouts",
      "Hotkey-toggleable overlay for QA and design review"
    ],
    "compositionHints": [
      "Mount once near the app root, gated behind an environment check",
      "Pair with a layout to visualize breakpoint changes while resizing"
    ],
    "hasReducedMotion": true
  }
}
