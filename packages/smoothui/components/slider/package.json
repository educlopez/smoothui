{
  "name": "@repo/slider",
  "description": "Animated Slider primitive for SmoothUI with spring thumb press feedback.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "slider",
      "form",
      "animated"
    ],
    "complexity": "simple",
    "animationType": "spring",
    "useCases": [
      "Volume and range controls",
      "Numeric value selection"
    ],
    "compositionHints": [
      "Compose Root, Control, Track, Indicator, Thumb",
      "Or use the default convenience Slider"
    ],
    "hasReducedMotion": true
  }
}
