{
  "name": "@repo/toggle",
  "description": "Animated Toggle primitive for SmoothUI with press scale and pressed background.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "toggle",
      "action",
      "animated"
    ],
    "complexity": "simple",
    "animationType": "spring",
    "useCases": [
      "Toolbar on/off actions",
      "Format toggles (bold, italic)"
    ],
    "compositionHints": [
      "Use inside ToggleGroup for segmented control"
    ],
    "hasReducedMotion": true
  }
}
