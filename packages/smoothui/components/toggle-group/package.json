{
  "name": "@repo/toggle-group",
  "description": "Animated Toggle Group primitive for SmoothUI — segmented single or multi selection.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "toggle-group",
      "segmented",
      "action",
      "animated"
    ],
    "complexity": "simple",
    "animationType": "spring",
    "useCases": [
      "Segmented control",
      "Multi-select toolbar group"
    ],
    "compositionHints": [
      "Nest Toggle children with value props",
      "Use multiple for multi-select"
    ],
    "hasReducedMotion": true
  }
}
