{
  "name": "@repo/otp-field",
  "description": "OTP Field for SmoothUI with Base UI twin and Radix-parity twin for one-time codes.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "otp",
      "pin",
      "verification",
      "input"
    ],
    "complexity": "simple",
    "useCases": [
      "Email / SMS verification codes",
      "Two-factor authentication PIN entry"
    ],
    "compositionHints": [
      "Set length to match your code size",
      "Use mask on shared screens"
    ]
  }
}
