{
  "name": "@repo/morph-icon",
  "description": "A MorphIcon component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "icons",
    "tags": [
      "icon",
      "morph",
      "svg",
      "toggle",
      "animated",
      "menu",
      "checkbox",
      "play"
    ],
    "complexity": "moderate",
    "animationType": "tween",
    "useCases": [
      "Hamburger-to-close menu button icon",
      "Animated checkbox / checkmark toggle icon",
      "Play-to-stop media control icon",
      "View-mode toggle icons (list, grid, compact)"
    ],
    "compositionHints": [
      "Drive the active prop from the same state that toggles the surrounding control",
      "Pass a label prop when the icon is not accompanied by visible text"
    ],
    "hasReducedMotion": true
  }
}
