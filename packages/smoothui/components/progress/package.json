{
  "name": "@repo/progress",
  "description": "Animated Progress for SmoothUI with Base UI / Radix twins, determinate and indeterminate states.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "progress",
      "loading",
      "bar",
      "indeterminate",
      "animated"
    ],
    "complexity": "simple",
    "useCases": [
      "Determinate upload / task progress bar",
      "Indeterminate loading indicator"
    ],
    "compositionHints": [
      "Use Progress.Label and Value compounds for labelled progress",
      "Pair with Field or card headers"
    ],
    "hasReducedMotion": true
  }
}
