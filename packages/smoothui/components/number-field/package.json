{
  "name": "@repo/number-field",
  "description": "Number Field for SmoothUI with steppers, Base UI twin and Radix-parity twin.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "number",
      "stepper",
      "input",
      "form"
    ],
    "complexity": "simple",
    "useCases": [
      "Quantity steppers",
      "Numeric settings with min/max/step"
    ],
    "compositionHints": [
      "Pass label for scrub-friendly accessible naming",
      "Pair with Field for form validation"
    ]
  }
