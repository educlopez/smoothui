{
  "name": "@repo/badge",
  "description": "Compact Badge and Status Dot for SmoothUI — labels, tags, and presence indicators.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "badge",
      "tag",
      "status",
      "label",
      "display"
    ],
    "complexity": "simple",
    "useCases": [
      "Status labels on list rows",
      "Filter tags and category chips",
      "Presence status dots"
    ],
    "compositionHints": [
      "Use StatusDot inside Avatar for presence",
      "Prefer outline for quiet metadata"
    ]
  }
}
