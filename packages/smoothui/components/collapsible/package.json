{
  "name": "@repo/collapsible",
  "description": "Animated Collapsible primitive for SmoothUI with CSS height panel animation.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.25",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "collapsible",
      "navigation",
      "animated"
    ],
    "complexity": "simple",
    "animationType": "css",
    "useCases": [
      "Single expandable region",
      "Show more / show less"
    ],
    "compositionHints": [
      "Compose CollapsibleRoot, Trigger, Panel"
    ],
    "hasReducedMotion": true
  }
}
