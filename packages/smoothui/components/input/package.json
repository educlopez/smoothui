{
  "name": "@repo/input",
  "description": "Base UI Input primitive for SmoothUI matching FieldControl styling. Base-only.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "input",
      "form",
      "text",
      "field"
    ],
    "complexity": "simple",
    "useCases": [
      "Text input standalone or inside Field",
      "Email, password, and search inputs"
    ],
    "compositionHints": [
      "Wrap in Field for label, description, and error",
      "Use aria-invalid for error styling"
    ]
  }
}
