{
  "name": "@repo/preview-card",
  "description": "Hover preview card for SmoothUI with Base UI / Radix HoverCard twins and Motion overlay.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "motion": "^12.23.25",
    "radix-ui": "1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "preview-card",
      "hover-card",
      "popover",
      "overlay",
      "animated"
    ],
    "complexity": "moderate",
    "useCases": [
      "Link preview on hover",
      "Rich user profile tooltip"
    ],
    "compositionHints": [
      "Use PreviewCardTrigger on links",
      "Keep content non-interactive-heavy"
    ],
    "hasReducedMotion": true
  }
}
