{
  "name": "@repo/duration-picker",
  "description": "A DurationPicker component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "form",
    "tags": [
      "duration",
      "time",
      "input",
      "spinbutton",
      "scrub",
      "picker",
      "form"
    ],
    "complexity": "complex",
    "animationType": "spring",
    "useCases": [
      "Timer or countdown duration input",
      "Video/audio trim length editor",
      "Scheduling forms that need hours/minutes/seconds"
    ],
    "compositionHints": [
      "Pair with a form label and description text",
      "Use inside a settings panel or scheduling dialog"
    ],
    "hasReducedMotion": true
  }
}
