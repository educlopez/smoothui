{
  "name": "@repo/textarea",
  "description": "Multi-line Textarea for SmoothUI matching Input / FieldControl styling. Base-only.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "textarea",
      "form",
      "input",
      "field"
    ],
    "complexity": "simple",
    "useCases": [
      "Multi-line messages and notes",
      "Comments inside Field"
    ],
    "compositionHints": [
      "Wrap in Field for label and error",
      "Use Input Group for addon slots around single-line inputs"
    ]
  }
}
