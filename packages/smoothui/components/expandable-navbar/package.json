{
  "name": "@repo/expandable-navbar",
  "description": "An ExpandableNavbar component for SmoothUI.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@repo/shadcn-ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.25"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "navigation",
    "tags": [
      "navbar",
      "navigation",
      "mega-menu",
      "expandable",
      "height-animation",
      "cross-fade",
      "animated"
    ],
    "complexity": "advanced",
    "animationType": "spring",
    "useCases": [
      "Mega-menu navbar that expands downward to reveal category panels",
      "Product navigation with hover-triggered rich content panels",
      "Docs navbar with an expandable resources panel"
    ],
    "compositionHints": [
      "Pass any React content as an item's panel field",
      "Use openId / onOpenChange for controlled navigation state"
    ],
    "hasReducedMotion": true
  }
}
