{
  "name": "@repo/spinner",
  "description": "Accessible loading Spinner for SmoothUI with Motion and reduced-motion support.",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@repo/smoothui-utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  },
  "smoothui": {
    "category": "patterns",
    "tags": [
      "spinner",
      "loading",
      "progress",
      "display"
    ],
    "complexity": "simple",
    "useCases": [
      "Inline button loading",
      "Page or panel busy state"
    ],
    "compositionHints": [
      "Always provide a label via children or aria-label",
      "Pair with Skeleton for content placeholders"
    ]
  }
}
