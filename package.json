{
  "name": "smoothui-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:cli": "pnpm --filter smoothui-cli build",
    "dev": "turbo dev",
    "lint": "ultracite check",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "pnpm test:risk && turbo test",
    "test:browser": "playwright test",
    "test:risk": "vitest run --config vitest.risk.config.ts",
    "typecheck": "turbo typecheck",
    "typecheck:cli": "pnpm --filter smoothui-cli typecheck",
    "analyze": "turbo analyze",
    "bump-deps": "npx npm-check-updates --deep -u -x shiki,next,recharts,require-in-the-middle && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/shadcn-ui && npx shadcn@latest migrate radix -c packages/shadcn-ui",
    "clean": "git clean -xdf node_modules",
    "calculate-sizes": "pnpm exec tsx scripts/calculate-bundle-sizes.ts",
    "calculate-new": "pnpm exec tsx scripts/calculate-new-components.ts",
    "actions:check": "pnpm exec tsx scripts/refresh-action-pins.ts",
    "actions:update": "pnpm exec tsx scripts/refresh-action-pins.ts --write",
    "lockfile:check": "ruby scripts/validate-lockfile.rb",
    "lockfile:test": "ruby scripts/validate-lockfile.test.rb",
    "pack:cli": "pnpm --filter smoothui-cli pack:release",
    "prepare": "husky",
    "verify:cli-package": "pnpm --filter smoothui-cli verify:package -- --pack-json .release/cli-pack.json --artifact-dir .release/artifacts --source-package package.json",
    "media:upload": "tsx scripts/upload-media.ts"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.1",
    "@smoothui/data": "workspace:*",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsup": "^8.5.1",
    "tsx": "4.23.1",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "ultracite": "^7.9.4",
    "vite": "^7.3.6",
    "vitest": "4.1.8",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.{json,css,md,mdx}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
