{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-header": "Release PR — review the version bump and changelog, then merge to cut the release.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "smoothui-cli",
      "component": "cli",
      "include-component-in-tag": true,
      "exclude-paths": [
        ".agents/**",
        ".claude/**",
        ".codegraph/**",
        ".codex/**",
        ".cursor/**",
        ".github/**",
        ".husky/**",
        ".notes/**",
        ".opencode/**",
        ".ui-craft/**",
        ".vscode/**",
        "OaUch3qNT5CdTS0N7JyDx/**",
        "apps/**",
        "packages/**",
        "registry/**",
        "sdd/**",
        "tests/**",
        "tsx-501/**",
        ".autorc",
        ".DS_Store",
        ".eslintrc.json",
        ".gitignore",
        ".gitleaksignore",
        ".npmrc",
        ".release-please-manifest.json",
        "AGENTS.md",
        "AI-SECTION-PLAN.md",
        "ANIMATION_IMPROVEMENTS.md",
        "biome.jsonc",
        "CHANGELOG.md",
        "CHAT-TEMPLATE-REFERENCE.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "DOCS-LAYOUT-AUDIT.md",
        "DS-AUDIT.md",
        "LICENSE",
        "package.json",
        "README.md",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "release-please-config.json",
        "scripts/calculate-bundle-sizes.ts",
        "scripts/calculate-new-components.ts",
        "scripts/refresh-action-pins.ts",
        "scripts/release-scope.test.ts",
        "scripts/validate-lockfile.rb",
        "scripts/validate-lockfile.test.rb",
        "scripts/validate-lockfile.test.ts",
        "scripts/validate-lockfile.ts",
        "skills-lock.json",
        "tsconfig.json",
        "turbo.json",
        "vitest.risk.config.ts"
      ]
    },
    "packages/smoothui": {
      "package-name": "smoothui"
    }
  }
}
